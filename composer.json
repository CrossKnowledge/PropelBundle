{
  "name": "propel/propel-bundle",
  "description": "Integration of Propel in Symfony2",
  "keywords": ["propel", "orm", "persistence"],
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [{
    "name": "William Durand",
    "email": "william.durand1@gmail.com"
  }],

  "autoload": {
    "psr-4": { "Propel\\Bundle\\PropelBundle\\": "" },
    "files": ["autoload_aliases.php"],
    "exclude-from-classmap": [ "Tests/" ]
  },

  "require": {
    "php": "^7.2|^8.3",
    "propel/propel1": "1.6.19|^5.0",
    "symfony/framework-bundle": "^3.0|^4.0|^5.0",
    "symfony/symfony": "^4.0|^5.0"
  },
  "require-dev": {
    "ext-sqlite3": "*",
    "sensio/framework-extra-bundle": "^4.0|^5.0",
    "fakerphp/faker": "^1.5",
    "phpunit/phpunit": "^8.5.27",
    "symfony/phpunit-bridge": "^6"
  },

  "conflict": {
    "symfony/propel1-bridge": ">=2.8.0"
  },

  "replace": {
    "symfony/propel1-bridge": "<=2.8.0"
  },
  "suggest": {
    "propel/propel-acl-bundle": "For using the Propel ACL implementation"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/CrossKnowledge/Propel.git",
      "packagist.org": false
    }
  ]
}
